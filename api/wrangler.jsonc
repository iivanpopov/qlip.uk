{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "qlip-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-21",
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }],
  },
  "exports": {
    "Room": { "type": "durable-object", "storage": "sqlite" },
  },
  "secrets": {
    "required": ["TURN_TOKEN", "TURNSTILE_SECRET"],
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
  ],
  "routes": [
    {
      "pattern": "api.qlip.uk",
      "custom_domain": true,
    },
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
    },
  },
}
