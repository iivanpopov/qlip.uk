{
  "name": "qlip.uk",
  "private": true,
  "workspaces": {
    "packages": [
      "web",
      "api"
    ],
    "catalog": {
      "@types/node": "^26.6.6",
      "typescript": "^7.0.2",
      "wrangler": "^4.158.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel --filter '*' dev",
    "dev:web": "bun run --filter qlip-web dev",
    "dev:api": "bun run --filter qlip-api dev",
    "build": "bun run --parallel --filter '*' build",
    "check": "bun fmt --check && bun run --parallel --filter '*' check",
    "deploy": "bun run --sequential --filter '*' deploy",
    "deploy:web": "bun run --filter qlip-web deploy",
    "deploy:api": "bun run --filter qlip-api deploy",
    "types": "bun run --filter qlip-api types",
    "prepare": "git config core.hooksPath .hooks"
  },
  "packageManager": "bun@1.4.4"
}
