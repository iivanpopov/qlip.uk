{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "svelte": true,
  "singleQuote": true,
  "sortImports": {
    "groups": [
      "type-builtin",
      "builtin",
      "type-external",
      "external",
      "type-internal",
      "internal",
      "type-parent",
      "parent",
      "type-sibling",
      "sibling",
      "type-index",
      "index",
      "style",
      ["side_effect", "side_effect_style"],
      "unknown"
    ]
  }
}
