{
  "format_on_save": "on",
  "prettier": { "allowed": false },
  "formatter": {
    "external": {
      "command": "bun",
      "arguments": ["fmt", "--stdin-filepath", "{buffer_path}"]
    }
  },
  "languages": {
    "Svelte": {
      "language_servers": [
        "...",
        "!vtsls",
        "!stylelint-lsp",
        "!oxfmt",
        "!unocss-language-server",
        "!tailwindcss-language-server",
        "!oxlint",
        "!eslint"
      ]
    },
    "TypeScript": {
      "language_servers": [
        "...",
        "!vtsls",
        "!stylelint-lsp",
        "!oxfmt",
        "!unocss-language-server",
        "!tailwindcss-language-server",
        "!oxlint",
        "!eslint"
      ]
    },
    "JSON": {
      "language_servers": [
        "...",
        "!vtsls",
        "!stylelint-lsp",
        "!oxfmt",
        "!unocss-language-server",
        "!tailwindcss-language-server",
        "!oxlint",
        "!eslint"
      ]
    },
    "JSONC": {
      "language_servers": [
        "...",
        "!vtsls",
        "!stylelint-lsp",
        "!oxfmt",
        "!unocss-language-server",
        "!tailwindcss-language-server",
        "!oxlint",
        "!eslint"
      ]
    }
  }
}
