{
  "format_on_save": "on",
  "prettier": {
    "allowed": false
  },
  "languages": {
    "JSON": {
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "JSONC": {
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "Svelte": {
      "formatter": [
        { "language_server": { "name": "oxfmt" } },
        { "code_action": "source.fixAll.oxc" }
      ],
      "language_servers": [
        "...",
        "!stylelint-lsp",
        "!vtsls",
        "!typescript-language-server",
        "!eslint",
        "!tailwindcss-language-server"
      ]
    },
    "JavaScript": {
      "formatter": [
        { "language_server": { "name": "oxfmt" } },
        { "code_action": "source.fixAll.oxc" }
      ],
      "language_servers": [
        "...",
        "!stylelint-lsp",
        "!vtsls",
        "!typescript-language-server",
        "!eslint",
        "!tailwindcss-language-server"
      ]
    },
    "TypeScript": {
      "formatter": [
        { "language_server": { "name": "oxfmt" } },
        { "code_action": "source.fixAll.oxc" }
      ],
      "language_servers": [
        "...",
        "!stylelint-lsp",
        "!vtsls",
        "!typescript-language-server",
        "!eslint",
        "!tailwindcss-language-server"
      ]
    }
  }
}
