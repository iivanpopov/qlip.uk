{
  "format_on_save": "on",
  "prettier": { "allowed": false },
  "formatter": {
    "external": {
      "command": "bun",
      "arguments": ["fmt", "--stdin-filepath", "{buffer_path}"]
    }
  },
  "lsp": {
    "typescript-ls": {
      "binary": {
        "path": "node_modules/.bin/tsrs",
        "arguments": ["--lsp", "--stdio"]
      }
    }
  },
  "languages": {
    "Svelte": {
      "language_servers": [
        "...",
        "!vtsls",
        "!stylelint-lsp",
        "!oxfmt",
        "!unocss-language-server",
        "!tailwindcss-language-server",
        "!oxlint",
        "!eslint"
      ]
    },
    "TypeScript": {
      "language_servers": [
        "typescript-ls",
        "...",
        "!vtsls",
        "!typescript-language-server",
        "!stylelint-lsp",
        "!oxfmt",
        "!unocss-language-server",
        "!tailwindcss-language-server",
        "!oxlint",
        "!eslint"
      ]
    },
    "TSX": {
      "language_servers": ["typescript-ls", "...", "!vtsls", "!typescript-language-server"]
    },
    "JavaScript": {
      "language_servers": ["typescript-ls", "...", "!vtsls", "!typescript-language-server"]
    },
    "JSON": {
      "language_servers": [
        "...",
        "!vtsls",
        "!stylelint-lsp",
        "!oxfmt",
        "!unocss-language-server",
        "!tailwindcss-language-server",
        "!oxlint",
        "!eslint"
      ]
    },
    "JSONC": {
      "language_servers": [
        "...",
        "!vtsls",
        "!stylelint-lsp",
        "!oxfmt",
        "!unocss-language-server",
        "!tailwindcss-language-server",
        "!oxlint",
        "!eslint"
      ]
    }
  }
}
